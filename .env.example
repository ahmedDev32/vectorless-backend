# Copy to .env for local dev, or set these as Vercel project environment variables.

SECRET_KEY=
DEBUG=False

# Postgres connection string, e.g. from Supabase/Neon/Vercel Postgres.
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# OpenRouter (LLM planner / synthesis)
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
OPENROUTER_MODEL=gpt-4o-mini

# Safety caps on LLM-generated SQL execution
SQL_QUERY_MAX_ROWS=200
SQL_QUERY_TIMEOUT_MS=5000

# Comma-separated list of extra allowed frontend origins (besides localhost:3000),
# e.g. https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=
